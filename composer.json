{
    "name": "oxid-esales/jwt-authentication-component",
    "description": "Authentication component for OXID eShop with JWT support",
    "type": "oxideshop-component",
    "keywords": [
        "oxid",
        "authentication",
        "api",
        "security",
        "jwt"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "OXID eSales AG",
            "email": "info@oxid-esales.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/security-core": "^6.4",
        "symfony/security-http": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "lcobucci/jwt": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "OxidEsales\\AuthComponent\\": "src/",
            "OxidEsales\\AuthComponent\\Tests\\": "tests/"
        }
    }
}
